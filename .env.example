# Çankırı Gazozu — ortam değişkenleri örneği
#
# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# `.env.local` ASLA depoya commit edilmez (bkz. .gitignore).
#
# (.gitignore `.env*` kalıbını yok sayar ama `!.env.example` istisnasıyla
# bu örnek dosya depoda tutulur.)


# ─────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL — sitenin canlı adresi (sonunda / olmadan)
# ─────────────────────────────────────────────────────────────────────────
# canonical, hreflang, sitemap.xml, robots.txt ve Open Graph adreslerinin
# tamamı buradan üretilir. YANLIŞ DEĞER TÜM SEO SİNYALLERİNİ YANLIŞ DOMAINE
# GÖNDERİR. Alan adı (.com mu .com.tr mi) kesinleşmeden yayına çıkmayın.
# Boş bırakılırsa: https://cankirigazozu.com varsayılır (henüz doğrulanmadı).
NEXT_PUBLIC_SITE_URL=https://cankirigazozu.com.tr


# ─────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY — bayilik başvurusu bildirim e-postası için Resend anahtarı
# ─────────────────────────────────────────────────────────────────────────
# https://resend.com üzerinden alınır, `re_` ile başlar.
# Boş bırakılırsa: bildirim e-postası HİÇ gönderilmez. Geliştirmede başvuru
# yalnızca dosya deposuna yazılır; ÜRETİMDE hem bu anahtar hem de
# DEALER_STORE_DIR boşsa form kullanıcıya hata gösterir (sahte başarı yok).
RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# DEALER_MAIL_TO — bayilik başvurularının düşeceği gerçek e-posta adresi
# ─────────────────────────────────────────────────────────────────────────
# Boş bırakılırsa: src/data/site.ts içindeki dealerEmail kullanılır
# (şu an info@cankirigazozu.com — henüz doğrulanmadı).
DEALER_MAIL_TO=


# ─────────────────────────────────────────────────────────────────────────
# DEALER_MAIL_FROM — bildirim e-postasının gönderen adı ve adresi
# ─────────────────────────────────────────────────────────────────────────
# Biçim: "Çankırı Gazozu <bayilik@cankirigazozu.com.tr>"
# Adresin alan adı Resend'de doğrulanmış olmalı, aksi halde gönderim reddedilir.
# Boş bırakılırsa: "Çankırı Gazozu <onboarding@resend.dev>" (Resend'in test
# gönderen adresi — yalnızca deneme içindir, üretimde kullanılmamalı).
DEALER_MAIL_FROM=


# ─────────────────────────────────────────────────────────────────────────
# DEALER_STORE_DIR — başvuruların yazıldığı JSONL deposunun dizini
# ─────────────────────────────────────────────────────────────────────────
# Her başvuru bu dizindeki dealer-applications.jsonl dosyasına bir satır
# olarak eklenir (append-only).
# Boş bırakılırsa: geliştirmede proje kökündeki .data/ klasörü kullanılır;
# ÜRETİMDE hiçbir varsayılan yoktur, depo devre dışı kalır.
#
# UYARI: Vercel gibi serverless ortamlarda dosya sistemi kalıcı DEĞİLDİR.
# Orada bu değişken ancak kalıcı bir disk/volume'a işaret ediyorsa anlamlıdır;
# aksi halde gerçek bir veritabanı bağlanmalıdır (bkz. src/lib/dealer.ts).
DEALER_STORE_DIR=


# ─────────────────────────────────────────────────────────────────────────
# SITE_INDEXABLE — arama motorlarının siteyi taramasına izin verilsin mi?
# ─────────────────────────────────────────────────────────────────────────
# robots.txt'yi doğrudan belirler. 1/true/yes/on → açık, 0/false → kapalı.
# Boş bırakılırsa: Vercel'de yalnızca production indekslenir; Vercel dışında
# NODE_ENV=production yeterli sayılır (bkz. src/app/robots.ts).
# Yayına kapalı bir staging/tanıtım ortamı kuruyorsanız: SITE_INDEXABLE=0
SITE_INDEXABLE=
